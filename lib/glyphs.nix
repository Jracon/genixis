# The powerline glyphs that more than one surface draws
# (docs/terminal-aesthetic.md): the prompt of starship and the tab bar of
# tmux. A private-use byte renders no shape in a plain editor, so the
# codepoints ride in this comment: arrow U+E0B0 closes a filled segment,
# capLeft U+E0B2 opens one, and the round caps U+E0B6 and U+E0B4 end a line
# the round way.
{
  arrow = "";
  capLeft = "";
  capRoundLeft = "";
  capRoundRight = "";
}
